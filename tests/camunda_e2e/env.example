APP_CODE=test_request
SESSION_SECRET=camunda-e2e-dev-only
OZON_LOCALEDIR=/tmp/ozon-locale
OZON_APPLANG=it

# APP_TOKEN NON serve piu' come singolo token: il test minta un JWT keycloak
# PER UTENTE (utente/responsible/manager) e il worker usa e2e-admin. Lasciare
# vuoto; valorizzare solo per forzare un token statico unico (override).
APP_TOKEN=

# L'app nel compose-test gira AUTH_MODE=keycloak (override) e valida il JWT.
AUTH_MODE=keycloak

# Keycloak (usato da tests/camunda_e2e/auth.py per mintare i token per-utente).
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=backend
KEYCLOAK_CLIENT_ID=backend-web
KEYCLOAK_CLIENT_SECRET=camunda-e2e-secret
KEYCLOAK_E2E_PASSWORD=e2e
E2E_ADMIN_USER=e2e-admin

# Tutti gli uid di test sono admin (shortcut e2e: il gating assignee e' nel BPMN,
# non nell'ACL app). e2e-admin fa il seed.
ADMINS=e2e-admin,utente,responsible,manager
CAMUNDA_ENABLED=true
CAMUNDA_AUTH_ENABLED=false
MONGO_USER=test
MONGO_PASS=test
MONGO_DB=ozon_test
MONGO_URL=db:27017
BACKEND_INTERFACE=db
# Singolo container Camunda 8.9 (in-memory/H2): gRPC + REST v2 unificata.
CAMUNDA_ZEEBE_ADDRESS=camunda:26500
CAMUNDA_ZEEBE_SECURE=false
CAMUNDA_TASKLIST_URL=http://camunda:8080
CAMUNDA_REST_ADDRESS=http://camunda:8080/v2

WORKER_TIMEOUT_MS=30000
CAMUNDA_E2E_DEPLOY_BPMN=true
