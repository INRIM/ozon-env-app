# Env specifico di mcp_search.
# Nessuna credenziale propria: il server non ha un'identita' verso
# ozon-env-app, ogni chiamata al tool inoltra l'Authorization bearer del
# chiamante MCP cosi' com'e'.

# Base URL di ozon-env-app (sulla rete ozn-network).
MCP_SEARCH_OZON_BASE_URL=http://ozon-env-app:8000

# Bind del server MCP stesso (transport HTTP, non stdio: il chiamante e'
# remoto, non un client desktop locale).
MCP_SEARCH_HOST=0.0.0.0
MCP_SEARCH_PORT=8090
MCP_SEARCH_PATH=/mcp

# --- Opzionali (default nel codice) ---
#MCP_SEARCH_HTTP_TIMEOUT=30
#MCP_SEARCH_DEFAULT_LIMIT=50
#MCP_SEARCH_MAX_LIMIT=200
