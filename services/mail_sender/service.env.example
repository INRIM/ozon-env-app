# Env specifico di mail_sender (override del .env base dello stack).
# Copia in service.env (gitignored) solo se vuoi cambiare i default.
# I parametri SMTP NON stanno qui: il worker legge mail_server_out dal DB.

#MAIL_POLL_INTERVAL=30          # secondi tra un poll e l'altro della coda
#OZON_APP_NAME=App              # nome app nei template (fallback APP_CODE)
#EXTERNAL_BASE_URL=             # base url per link nei template
#MAIL_BASE_TEMPLATE=            # path template html custom
NETWORK=ozon-net