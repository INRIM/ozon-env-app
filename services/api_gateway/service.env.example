# Env specifico di api_gateway (override del .env base dello stack).
# Generato/gestito da ./run.sh come `service.env` (gitignored).
# Copia in service.env solo se vuoi configurare a mano.

# --- Auth service-to-service (obbligatoria) ---
# Stesso valore di REMOTE_SELECT_S2S_TOKEN nel .env di ozon-env-app.
# Senza questa var il gateway NON parte.
API_GATEWAY_S2S_TOKEN=
# Header su cui l'app presenta il token (= REMOTE_SELECT_S2S_HEADER).
#API_GATEWAY_S2S_HEADER=x-ozon-s2s-token

# --- Var referenziate nei file di config/ come ${VAR} ---
# Il gateway non parte se una var referenziata e' vuota.
PEOPLE_URL=https://people.ininrim.it
PEOPLE_KEY=

# Per un upstream con auth M2M keycloak (blocco "auth" nel config), ad es.:
#PEOPLE_OAUTH_TOKEN_URL=
#PEOPLE_OAUTH_CLIENT_ID=
#PEOPLE_OAUTH_CLIENT_SECRET=

# --- Opzionali ---
# Path del config dentro il container (default: volume ./config).
#API_GATEWAY_CONFIG=/app/config/gateway.json
# Timeout di default verso gli upstream (override per upstream: "timeout").
#API_GATEWAY_HTTP_TIMEOUT=30
#API_GATEWAY_PORT=8080
#LOG_LEVEL=INFO
