# Env specifico di calendar_scheduler (override del .env base).
# Generato/gestito da ./run.sh come service.env (gitignored).

# Endpoint run dell'app (sulla rete ozn-network).
SCHEDULER_RUN_BASE_URL=http://ozon-env-app:8000

# Auth M2M keycloak (obbligatoria: l'endpoint run verifica il JWT keycloak).
# Tipicamente importati dal keycloak-manager via run.sh (prefisso SCHEDULER).
SCHEDULER_OAUTH_TOKEN_URL=
SCHEDULER_OAUTH_CLIENT_ID=
SCHEDULER_OAUTH_CLIENT_SECRET=
#SCHEDULER_OAUTH_AUDIENCE=

# --- Opzionali (default nel codice) ---
#SCHEDULER_POLL_INTERVAL=45
#SCHEDULER_TZ=Europe/Rome
