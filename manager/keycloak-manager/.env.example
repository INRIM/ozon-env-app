# keycloak-manager — config agnostica (nessun riferimento a un service specifico)
KC_SERVER_URL=https://keycloak.example.internal
KC_REALM=backend
# Realm dove autentica il client/utente admin (service account nel realm gestito
# -> mettere KC_REALM; admin-cli di solito -> master).
KC_ADMIN_REALM=master

# Auth admin — PREFERITO: service account (client_credentials), niente
# credenziali umane. Il client (es admin-rest-client) deve avere i ruoli
# realm-management (manage-clients, manage-clients-scopes...).
KC_ADMIN_CLIENT_ID=admin-rest-client
KC_ADMIN_CLIENT_SECRET=

# Fallback: password grant admin-cli (usato solo se KC_ADMIN_CLIENT_SECRET vuoto).
# Password vuota -> prompt interattivo (getpass).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

KC_VERIFY_TLS=true

# NB: prefisso env var e file di output NON sono qui: si scelgono nella pipeline
# (step 3). Cosi, messi i secret, questo .env non si tocca piu.
# L'output va in /out (volume -> ./out sull'host); default /out/kc-env.var.
