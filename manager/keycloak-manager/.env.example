# keycloak-manager — config agnostica (nessun riferimento a un service specifico)
KC_SERVER_URL=https://keycloak.example.internal
KC_REALM=backend
KC_ADMIN_REALM=master
KC_ADMIN_CLIENT_ID=admin-rest-client
KC_ADMIN_CLIENT_SECRET=
KC_VERIFY_TLS=true

# Fallback: password grant admin-cli (usato solo se KC_ADMIN_CLIENT_SECRET vuoto).
# Password vuota -> prompt interattivo (getpass).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
