APP_CODE=
OZON_APP_NAME=ozon-env-api
OZON_APP_VERSION=1.0.0
LOG_LEVEL=info

NETWORK=ozon-net
CAMUNDA_NETWORK=camunda-8-local

ASGI_HOST=0.0.0.0
ASGI_PORT=8000

AUTH_MODE=token
TOKEN_HEADER=Authorization
KEYCLOAK_REMOTE_USER_HEADER=x-remote-user

# `aud` atteso nei token keycloak. VUOTO = nessun controllo di audience:
# qualunque token del realm viene accettato, anche se emesso per un
# altro client. Valorizzarlo con l'audience configurata su keycloak per
# questa app. NB: impostarlo con un valore che non combacia produce 401
# su tutte le richieste — allinearlo prima lato keycloak.
OZON_TOKEN_AUDIENCE=

# Origin ammessi per l'handshake WebSocket (CSV), difesa CSWSH. Se vuoto
# viene usato EXTERNAL_BASE_URL come unico origin consentito per le
# connessioni autenticate via cookie.
WS_ALLOWED_ORIGINS=

MONGO_USER=
MONGO_PASS=
MONGO_URL=
MONGO_DB=
MONGO_REPLICA=

MODELS_FOLDER=/models
PLUGINS_FOLDER=/plugins
EXTERNAL_BASE_URL=http://localhost:8080

# Obbligatorio in ogni deploy con piu' worker/repliche (senza, ogni
# processo genera un fallback casuale proprio — vedi
# docs/SECURITY_KEYCLOAK_TOKEN_ANALYSIS.it.md finding #5).
SESSION_SECRET=change-me
# true in produzione (default applicativo). Va messo a false SOLO per dev
# locale su http semplice (nessun HTTPS davanti).
COOKIE_SECURE=true
AUTH_COOKIE_NAME=ozon_session
AUTH_COOKIE_MAX_AGE=86400
AUTH_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=ozon_csrf
AUTH_STATE_COOKIE_NAME=ozon_state
POST_LOGIN_REDIRECT_URL=/
LOGOUT_REDIRECT_URL=/

KEYCLOAK_REALM=backend
KEYCLOAK_CLIENT_ID=backend-web
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_SERVER_URL_PUBLIC=https://keycloak.example.internal
KEYCLOAK_SERVER_URL_INTERNAL=https://keycloak.example.internal
KEYCLOAK_WORKER_CLIENT_ID="nob-worker"
KEYCLOAK_WORKER_CLIENT_SECRET="WORKER_SECRET"

# Zeebe gRPC gateway, non URL web/REST. Esempi:
# - self-managed compose: orchestration:26500
# - TLS/proxy: camunda.example.internal:443
# Compatibile anche con CAMUNDA_CLIENT_GRPCADDRESS=http://orchestration:26500.
CAMUNDA_ZEEBE_ADDRESS=camunda.example.internal:443
CAMUNDA_ZEEBE_SECURE=true
# REST base Camunda 8.9, es. http://orchestration:8080.
# Compatibile anche con CAMUNDA_CLIENT_RESTADDRESS=http://orchestration:8080.
CAMUNDA_TASKLIST_URL=
CAMUNDA_OAUTH_TOKEN_URL=
CAMUNDA_CLIENT_ID=nob-service-client
CAMUNDA_CLIENT_SECRET=change-me
CAMUNDA_TENANT_ID=<default>
CAMUNDA_PROCESS_ID=
CAMUNDA_VERIFY_TLS=true
CAMUNDA_ENABLED=true
# Attesa post-complete: il click "completa task" torna solo dopo che
# l'eventuale service/external task ha risposto (prossimo user task o fine
# processo). 0 = nessuna attesa.
CAMUNDA_COMPLETE_WAIT_SECONDS=30
CAMUNDA_POLL_INTERVAL_SECONDS=0.5

RUNTIME_DEFAULT_PROCESS_ID=
RUNTIME_ACTION_PROCESS_MAP_JSON={}
RUNTIME_FUNCTION_PROCESS_MAP_JSON={}
RUNTIME_ADMIN_ROLES_JSON=["admin","manager","operator","user"]
RUNTIME_DEFAULT_APP_KEY=
RUNTIME_DEFAULT_FORM_KEY=request-form
RUNTIME_VALIDATE_PAYLOAD_SCHEMA=true
RUNTIME_REQUIRE_PUBLISHED_SCHEMA=false
RUNTIME_INTERNAL_TOKEN=

WORKFLOW_WAIT_TIMEOUT_SECONDS=5.0
WORKFLOW_WAIT_POLL_INTERVAL_SECONDS=0.5

UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_SIZE_MB=25
MODEL_FILE_DUMP_MODE=

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_ENABLED=true
# true = un file che non e' stato scansionato NON viene salvato. Va
# tenuto true: con false, ClamAV giu' / in timeout / un file oltre
# CLAMAV_MAX_STREAM_MB (limite che chi carica controlla gonfiando il
# file) finiscono a disco senza scansione e senza errore al chiamante.
CLAMAV_FAIL_CLOSED=true
CLAMAV_TIMEOUT_SECONDS=10.0
CLAMAV_MAX_STREAM_MB=25
CLAMAV_TMP_DIR=/tmp

# calendar_scheduler (worker scheduler — auth keycloak M2M)
# L'endpoint run verifica il bearer come JWT keycloak: niente token statico.
# Riusa il client worker keycloak (service account). NB: docker-compose NON
# espande i ${...} dentro .env, qui vanno valori CONCRETI.
SCHEDULER_RUN_BASE_URL=http://app:8000
SCHEDULER_OAUTH_TOKEN_URL=https://keycloak.example.internal/realms/backend/protocol/openid-connect/token
SCHEDULER_OAUTH_CLIENT_ID=nob-worker
SCHEDULER_OAUTH_CLIENT_SECRET=change-me
# aud del token; deve combaciare con OZON_TOKEN_AUDIENCE dell'app (vuoto = nessun check)
SCHEDULER_OAUTH_AUDIENCE=
SCHEDULER_TZ=Europe/Rome
SCHEDULER_POLL_INTERVAL=45
SCHEDULER_LOCK_TTL=1800
SCHEDULER_JOBSTORE_URL=sqlite:////data/calendar_scheduler.sqlite
IDENTITY_MANAGER_INTERVAL_MINUTES=10
